# ============================================
# 前端 .dockerignore
# ============================================
# 排除不需要打包到镜像的文件
# ============================================

# Flutter 构建产物（会在 Dockerfile 中重新构建）
build/
.dart_tool/

# 依赖缓存
.packages
.flutter-plugins
.flutter-plugins-dependencies

# 开发工具配置
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# 环境变量
.env
.env.*

# 测试
test/
coverage/

# 文档
README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# iOS/Android 原生项目（Web 不需要）
ios/
android/
macos/
windows/
linux/

# 临时文件
*.log
.DS_Store

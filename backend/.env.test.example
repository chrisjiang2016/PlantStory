# Dedicated PostgreSQL database for automated tests only.
# Copy values into your shell or CI secret; do not use DATABASE_URL from development or production.
#
# PowerShell:
# $env:TEST_DATABASE_URL='postgresql://plant_story_test:plant_story_test@127.0.0.1:5433/plant_story_test?schema=public'
# npm test
#
# The test runner executes `prisma db push --accept-data-loss`, so the target
# database must be disposable and must never contain development or production data.
TEST_DATABASE_URL="postgresql://plant_story_test:plant_story_test@localhost:5433/plant_story_test?schema=public"

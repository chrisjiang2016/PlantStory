# ============================================
# 后端 .dockerignore
# ============================================
# 排除不需要打包到镜像的文件
# ============================================

# 依赖（会在 Dockerfile 中重新安装）
node_modules/

# 测试文件
test/
*.spec.ts
*.e2e-spec.ts

# 开发工具配置
.vscode/
.idea/
*.swp
*.swo
*~

# 环境变量（敏感信息）
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# 日志
logs/
*.log
npm-debug.log*

# 数据库文件（本地开发用）
*.db
*.db-journal
dev.db*
test*.db

# 文档
README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# 备份文件
*.backup
*.bak

# 临时文件
tmp/
temp/
.cache/

# 构建产物（会在 Dockerfile 中重新构建）
dist/
build/

# TypeScript 缓存
*.tsbuildinfo

# 测试覆盖率
coverage/

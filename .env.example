# ============================================
# 植の物语 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 修改所有标记为 "CHANGE_ME" 的值
# 3. 不要将 .env 提交到版本库
# ============================================

# -------------------- 数据库配置 --------------------
POSTGRES_DB=plant_story
POSTGRES_USER=plant_story_user
POSTGRES_PASSWORD=CHANGE_ME_use_strong_password_here
POSTGRES_PORT=5432

# -------------------- 后端配置 --------------------
BACKEND_PORT=3000

# JWT 密钥（生成方法：openssl rand -base64 64）
JWT_SECRET=CHANGE_ME_use_long_random_string_minimum_32_characters
JWT_EXPIRES_IN=7d

# Refresh Token 密钥（生成方法：openssl rand -base64 64）
JWT_REFRESH_SECRET=CHANGE_ME_use_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# -------------------- 外部 API --------------------
# 百度 AI 植物识别
BAIDU_API_KEY=CHANGE_ME_your_baidu_api_key
BAIDU_SECRET_KEY=CHANGE_ME_your_baidu_secret_key

# Perenual 植物数据
PERENUAL_API_KEY=CHANGE_ME_your_perenual_api_key

# -------------------- 前端配置 --------------------
FRONTEND_PORT=80

# -------------------- 可选配置 --------------------
# 如果需要对外暴露不同端口，可以修改以下配置
# 例如：FRONTEND_PORT=8080 将前端映射到 http://localhost:8080

# -------------------- 生产环境建议 --------------------
# 1. POSTGRES_PASSWORD：使用至少 16 位随机字符串
# 2. JWT_SECRET：使用至少 32 位随机字符串
# 3. JWT_REFRESH_SECRET：必须与 JWT_SECRET 不同
# 4. 定期轮换密钥（至少每 90 天）
# 5. 使用密钥管理服务（如阿里云 KMS）存储敏感信息
